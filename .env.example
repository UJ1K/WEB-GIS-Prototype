DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false

# Use either DATABASE_URL or the individual PostgreSQL values below.
DATABASE_URL=
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=your-project-pooler-host
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Publishable key may be used by browser clients; never place the service-role key in templates or JavaScript.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
# Server-only secret used by Django to upload as a staff-authorized server operation.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy alternative if the project has not created a new secret API key.
SUPABASE_SERVICE_ROLE_KEY=
# New storage destinations. SUPABASE_STORAGE_BUCKET is retained for old dataset paths.
SUPABASE_GEODATA_BUCKET=Geospatial
SUPABASE_FILE_BUCKET=File-Data
SUPABASE_STORAGE_BUCKET=geospatial-data

# CARTO Voyager raster tiles. Keep this key server-side; do not add it to templates or JavaScript.
CARTO_API_KEY=
